# Proxmox API settings
# Copy this file to .env and replace placeholders.

PROXMOX_API_URL=https://proxmox.example.local:8006/api2/json
PROXMOX_API_TOKEN_ID=agent@pve!opencode
PROXMOX_API_TOKEN_SECRET=replace-me

# Optional settings
PROXMOX_VERIFY_SSL=true
PROXMOX_TIMEOUT_SECONDS=30
PROXMOX_DEFAULT_NODE=
PROXMOX_OUTPUT_FORMAT=json
PROXMOX_LOG_DIR=scripts/logs

# Console broker settings (optional, but recommended for safety)
# Keep empty to block all console access until an operator opts in.
PROXMOX_CONSOLE_ALLOWED_VMIDS=
PROXMOX_CONSOLE_TIER=1
PROXMOX_CONSOLE_REQUIRE_SNAPSHOT=true
PROXMOX_CONSOLE_SESSION_LOG_DIR=scripts/logs/console-sessions
PROXMOX_CONSOLE_KEY_DELAY=1.5
PROXMOX_CONSOLE_WATCH_INTERVAL=5.0

# LLM Endpoint Configuration
LLM_BASE_URL=http://localhost:1234/v1     # LM Studio, Ollama (http://localhost:11434/v1), vLLM, etc.
LLM_API_KEY=not-needed                     # API Key if required by provider
LLM_MODEL=qwen2.5-coder-7b-instruct        # Fallback model if backend detection (GET /v1/models) fails; startup uses the already-loaded backend model by default
LLM_TEMPERATURE=0.2
LLM_MAX_TURNS=15

# Chat Session Logging
CHAT_LOG_DIR=scripts/logs/chat-sessions
CHAT_AUTO_APPROVE=false
